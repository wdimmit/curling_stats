.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Cached video downloads and analysis output
cache/
out/
out_*/
runs/

# Generated review pages. Every one of these is rebuilt by
# `curling-score labels --fix` or `curling-score review` from data that IS
# tracked, and together they are ~340 MB of jpgs.
review/
review_*/
labelreview_*/
labelfix_*/
inspect/
inspect_*/

# One-off frames dropped at the repo root while looking at something.
/*.jpg
/*.png
review_ds11/
review_ds12/
.review_root/

# setuptools build tree from `pip install .`
build/

# Credentials, which belong in the deploy environment rather than here.
# worker.env carries the shared WORKER_TOKEN: the documented setup is to copy
# worker.env.example over it and fill it in, one `git add -A` away from
# committing the token to a public repo. The Firebase key is a public
# identifier and no secret, but it is still deploy config, not source.
deploy/worker.env
firebase_api_key.json

# Training binaries that live on the GPU box, not in a public repo. The
# harvested frames are derived — videos.json plus manifest.json rebuild them —
# and the retired weights are superseded by the one weights.py resolves.
datasets/ds11/ds11_images.tgz
datasets/ds12/ds12_images.tgz
/yolo11n.pt
weights/*.pt
!weights/ds11a.pt
# ds15a supersedes ds11a as the overhead detector (2026-09-23); ds11a is kept
# as the baseline every ds15 comparison was measured against.
!weights/ds15a.pt
# ds16a supersedes ds15a (2026-09-28): ds15a's set plus ds16, the 2026-27 season's
# houses (sheet 4's portrait button) and the toque. ds15a is kept as its baseline.
!weights/ds16a.pt
# ds17b supersedes ds16a (2026-10-09): ds16a's set plus ds17, sliding throwers' heads
# and the arriving stones a sweeper stands over. ds16a is kept as its baseline.
!weights/ds17b.pt
# overhead-3 supersedes ds17b (2026-10-30): ds17b's set plus the members' own /label
# boxes from the overhead panels and 45 empty panels of an ice logo
# (datasets/overhead-3). ds17b is kept as its baseline.
!weights/overhead-3.pt
# ds13a does not supersede ds11a: they read different cameras. ds11a detects
# stones in the overhead panels, looking straight down; ds13a detects them in
# the wide side view, edge-on at thirty metres, to time the hog crossing.
# Both are live, so both are kept.
!weights/ds13a.pt
!weights/ds13b.pt
# ds13c supersedes ds13b (2026-09-29): ds13b's set plus the hack wave, the hack to
# the tee. ds13b is kept as its baseline.
!weights/ds13c.pt
# ds13d supersedes ds13c (2026-10-12): ds13c's set plus the broom wave, the stone
# boxed alone where a broom, shoe or hand touches it. ds13c is kept as its baseline.
!weights/ds13d.pt
# ds13e supersedes ds13d (2026-10-13): ds13d's set plus the kink wave, frames where
# the delivery path kinked, the stone boxed alone. ds13d is kept as its baseline.
!weights/ds13e.pt
# long-1 supersedes ds13e (2026-10-28): ds13e's set plus the members' own /label boxes
# from the long camera (datasets/long-1). ds13e is kept as its baseline.
!weights/long-1.pt

# Harvested board frames for the card-digit training set. What training
# consumes is the ~24x22 px card window, and those are committed in
# datasets/board-cards-train/cards.npz -- a few hundred kilobytes for the same
# content. The 1080p frames they are cut from are ~1.2 MB each and would be a
# quarter of a gigabyte in git across ten videos, so only a handful under
# samples/ are kept, for spot-checking by eye. Regenerate the rest with:
#   ./.venv/bin/python scripts/collect_cards.py \
#       --dates 2026-04-13,2026-04-27 --step-s 300 --force
datasets/board-cards-train/**/*.png

# The frontend toolchain. Sources live in frontend/; the built bundles are
# tracked under src/curling_score/ because `curling-score serve` has to work
# after a plain pip install, with no node anywhere.
frontend/node_modules/

# Claude Code scratch: session worktrees and local agent config.
/.claude/
# broom1 is a third camera job, not a replacement: it finds the skip's broom
# head in the side view that looks at the destination house (2026-09-23).
!weights/broom1.pt
# broom2 supersedes broom1 (2026-09-24): round 3 added the red pads broom1 never
# saw. broom1 is kept as the baseline broom2 was measured against.
!weights/broom2.pt
# broom3 supersedes broom2 (2026-09-30): round 4, the 09/28 misses (a navy pad on
# sheet 5's green ring). broom2 is kept as the baseline broom3 was measured against.
!weights/broom3.pt
# spin1: the handle-point model (neck, grip end) the spin pass reads a rock's
# rotation with -- datasets/spin, the spike's p5. See game/spintime.py.
!weights/spin1.pt
# release1: the hand-on/hand-off model (a ResNet-18 on stacks of three grey
# crops round the handle, from the long camera facing the thrower) the release
# pass reads the release point with -- datasets/releasemarks, cut and trained
# by scripts/release. See game/releasetime.py. Trained 2026-10-22 on 217 marked
# rocks of 11 games. Each Super League game held out in turn (random rocks): 77%
# within 0.5 m of the hand mark, 93% within 1 m, median miss 0.20 m; the 10/20
# game held out, 15 of 16. Crops and results kept on the training box at
# /data/curling/release.
!weights/release1.pt

# Member-label images: re-fetchable from the site; the labels and jsonl are the record.
datasets/member-labels/**/images/
