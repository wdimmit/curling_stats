# What Cloud Build uploads as the build context.
#
# Without this file gcloud falls back to .gitignore, which keeps datasets/ and
# every model in weights/ -- 130 MB uploaded to build an API image that needs
# only src/. Docker's own .dockerignore does not apply: it filters what the
# daemon sees, after the upload has already happened.
.git/
.gcloudignore
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
# setuptools leaves this behind after `pip install .` or `pip wheel .`,
# and it is a stale second copy of everything under src/.
build/

# Training data, analysis output and the review pages built from them.
datasets/
runs/
tests/
validation/
out/
out_*/
review/
review_*/
labelreview_*/
labelfix_*/
inspect/
inspect_*/
design/
*.jpg
*.png
*.mp4
*.npz

# The API image needs no model at all; the worker image needs only the default
# one, which Dockerfile.worker names. Shipping the others is 60 MB per build.
weights/*
!weights/ds11a.pt

# Frontend sources and toolchain. The bundles esbuild produces are tracked
# under src/curling_score/, so the image needs none of this -- and
# node_modules would put back the 130 MB this file exists to avoid.
frontend/
