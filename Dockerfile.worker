# The processing worker: the pipeline, a GPU, ffmpeg and yt-dlp.
#
# Not built on a CUDA base image. PyTorch's wheels already carry the CUDA
# runtime, and the only thing that must come from the host is the driver, which
# the nvidia container runtime injects. That leaves the Python version free to
# match what the tests run on -- pytorch/pytorch ships 3.11, and this project
# requires 3.12, which is how the first build failed.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg libglib2.0-0 curl unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# yt-dlp needs a JavaScript runtime to solve YouTube's URL challenge; without
# one it warns and falls back to player clients whose media URLs are refused
# far more often. The first new video after launch drew two 403s in a row that
# way before the third attempt got through. Deno is the runtime yt-dlp looks
# for by default, so it only has to be on the PATH.
ARG DENO_VERSION=v2.5.2
RUN curl -fsSL "https://github.com/denoland/deno/releases/download/${DENO_VERSION}/deno-x86_64-unknown-linux-gnu.zip" \
        -o /tmp/deno.zip \
 && unzip -q /tmp/deno.zip -d /usr/local/bin && rm /tmp/deno.zip \
 && deno --version

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src

# cu121, deliberately: the worker host's driver is 525.105.17, which is CUDA
# 12.0, and PyTorch's cu121 build needs only >= 525.60.13. A cu124 build would
# want a 550-series driver and fail at run time, not at build time.
#
# Pinned because these decide what the detector sees. The detection cache keys
# on the source of rocks.py, yolo.py and calibrate.py but not on library
# versions, so a silent torch or opencv bump would change detections while
# every cache key stayed the same.
#
# The client half of the proof-of-origin token setup. yt-dlp reads the
# `youtubepot-bgutilhttp` extractor args that ingest/cache.py sets only when
# this plugin is installed -- without it the sidecar in
# docker-compose.worker.yml runs, answers nothing, and YouTube goes on saying
# "Sign in to confirm you're not a bot". Pinned to match the sidecar image.
RUN pip install --no-cache-dir \
        torch==2.5.1 torchvision==0.20.1 \
        --index-url https://download.pytorch.org/whl/cu121 \
 && pip install --no-cache-dir \
        "ultralytics==8.4.143" "numpy==2.5.3" \
        "opencv-python-headless==5.0.0.93" "av==18.1.0" \
 && pip install --no-cache-dir --no-deps . \
 && pip install --no-cache-dir "httpx>=0.27" "yt-dlp>=2026.8.19" \
        "bgutil-ytdlp-pot-provider==2.0.0"

# The production detector, pinned through the documented environment variable
# so `weights.default_path()` resolves it the same way everywhere.
#
# Keep the file's own name. `version.model_id` uses the stem, so copying this
# to `model.pt` would write "model-<hash>" into every timeline's
# processing_version and into the API's MODEL_ID check -- a name that says
# nothing about which detector ran. Change MODEL here and set MODEL_ID on the
# API to match, or the API refuses the worker's claim.
ARG MODEL=ds16a.pt
COPY weights/${MODEL} /opt/curling/weights/${MODEL}

# The SIDE-view detector, which times the throwing end's hog crossing. It must
# be shipped and pinned explicitly, because `weights.side_path()` treats a
# MISSING side model as "fall back to the colour scan" rather than an error --
# the overhead pipeline predates the side view and still runs without it. That
# is the right behaviour and the wrong failure here: an image built without
# this file would reprocess a whole archive, succeed, and quietly republish the
# old answers. Pinning the path turns that into a startup failure instead.
ARG SIDE_MODEL=ds13b.pt
COPY weights/${SIDE_MODEL} /opt/curling/weights/${SIDE_MODEL}

# The broom-head detector: the skip's target broom, read in the side view that
# looks at the destination house. Pinned for the side model's reason --
# `weights.broom_path()` treats a missing file as "no brooms", so an unpinned
# image would publish every shot with a null broom and call it success.
ARG BROOM_MODEL=broom2.pt
COPY weights/${BROOM_MODEL} /opt/curling/weights/${BROOM_MODEL}

ENV CURLING_SCORE_WEIGHTS=/opt/curling/weights/${MODEL} \
    CURLING_SCORE_SIDE_WEIGHTS=/opt/curling/weights/${SIDE_MODEL} \
    CURLING_SCORE_BROOM_WEIGHTS=/opt/curling/weights/${BROOM_MODEL} \
    CURLING_SCORE_CACHE=/data/cache PYTHONUNBUFFERED=1
VOLUME /data/cache
CMD ["python", "-m", "curling_score.service.worker"]
